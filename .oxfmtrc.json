{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": false,
  "printWidth": 100,
  "ignorePatterns": [
    "**/*.d.ts",
    ".vale/**",
    "build/**",
    "dist/**",
    "out/**",
    "src/i18n/i18n-svelte.ts",
    "src/i18n/i18n-types.ts",
    "src/i18n/i18n-util.*"
  ]
}
