{
  "name": "p2p.kiwi",
  "version": "3.11.0",
  "description": "p2p.kiwi is a simple and easy-to-use screen sharing tool for Mac, Windows, and Linux.",
  "homepage": "https://p2p.kiwi",
  "license": "MIT",
  "author": {
    "name": "The Don't Be Evil Company",
    "email": "marco@the-dont-be-evil-company.com"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "install:electron": "tsx ./node_modules/electron/install.js",
    "format": "vp fmt --write",
    "lint": "vp lint",
    "check": "vp check && pnpm run svelte-check",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "pnpm run typecheck:node && pnpm run svelte-check",
    "start": "electron-vite preview",
    "dev": "tsx ./scripts/dev.ts",
    "build": "pnpm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:windows": "pnpm run build && electron-builder --win --publish never",
    "build:macos": "make macos",
    "build:linux": "make linux",
    "build:linux-arm64": "make linux-arm64",
    "build:linux-debug": "VERSION=0.0.1-debug make linux-debug",
    "build:arch": "./scripts/build-arch.sh",
    "test": "vp test",
    "sidecar:build": "./native/overlay-sidecar/scripts/build.sh native/overlay-sidecar/dist",
    "sidecar:test": "./native/overlay-sidecar/scripts/test.sh",
    "sidecar:dev": "./native/overlay-sidecar/scripts/build.sh native/overlay-sidecar/dist",
    "sidecar:package": "./native/overlay-sidecar/scripts/build.sh native/overlay-sidecar/dist",
    "translations:watch": "typesafe-i18n"
  },
  "dependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/utils": "4.0.0",
    "@hpke/core": "1.10.1",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "electron-settings": "4.0.4",
    "electron-updater": "6.8.12",
    "sdp-compact": "0.0.11",
    "ts-mls": "1.6.4",
    "typesafe-i18n": "5.27.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "2.0.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "daisyui": "5.8.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.1",
    "electron-log": "5.4.4",
    "electron-vite": "6.0.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "prettier-plugin-svelte": "4.1.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "svelte": "5.57.3",
    "svelte-awesome-color-picker": "4.1.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "tslib": "2.9.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "vitest": "4.1.11"
  },
  "desktopName": "p2p.kiwi"
}
